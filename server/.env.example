# Environment
NODE_ENV=development
LOG_LEVEL=info

# Server
PORT=5000
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/indiegamerhub?retryWrites=true&w=majority
MONGO_USER=admin
MONGO_PASSWORD=password

# Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d

# Steam API (optional — public endpoint works without key for basic data)
# Get key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# RAWG.io API (free at https://rawg.io/apiv2)
RAWG_API_KEY=your_rawg_api_key_here

# Cloudinary (free at https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# API Timeouts & Limits
API_TIMEOUT_MS=12000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
